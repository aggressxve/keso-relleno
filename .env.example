# ============================================================
#  Plantilla de configuración del backend (Keso Relleno)
#  Copia este archivo como ".env" y ajusta los valores.
#  La app lo carga automáticamente (spring.config.import).
#  El archivo ".env" NO se sube al repositorio; esta plantilla SÍ.
# ============================================================

# ---------- Base de datos MySQL ----------
# URL completa de conexión. Si se omite, la app usa:
#   jdbc:mysql://localhost:3306/keso_pasteleria?createDatabaseIfNotExist=true
DB_URL=jdbc:mysql://localhost:3306/keso_pasteleria?createDatabaseIfNotExist=true
# Usuario y contraseña de MySQL (si se omiten, se usa root / root)
DB_USERNAME=root
DB_PASSWORD=root

# ---------- Seguridad JWT ----------
# Clave secreta para firmar los tokens. OBLIGATORIA.
# Usa una cadena larga y aleatoria, distinta en cada entorno.
JWT_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# ---------- Cuenta inicial de administrador ----------
# Solo se usa la primera vez, para crear/habilitar la cuenta de admin.
ADMIN_EMAIL=admin@keso.com
ADMIN_PASSWORD=cambia-esta-contrasena
